# ============================================================================
# Memanto for Hermes - environment configuration
# ============================================================================
# Hermes reads these from $HERMES_HOME/.env (default ~/.hermes/.env). The
# `hermes memory setup` wizard writes MEMANTO_API_KEY there for you.

# REQUIRED: Memanto Cloud API key — recommended (https://console.memanto.ai/sign-in)
MEMANTO_API_KEY=mk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL FALLBACK (Memanto local):
# If using Memanto local with Moorcheh instead of Memanto Cloud, set MOORCHEH_API_KEY
# (https://console.moorcheh.ai/api-keys) and leave MEMANTO_API_KEY blank.
# MOORCHEH_API_KEY=your_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: Override the Memanto agent id (memory namespace).
# Takes priority over agent_id in $HERMES_HOME/memanto.json.
# MEMANTO_AGENT_ID=hermes-coder
