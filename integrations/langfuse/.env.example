# langfuse-memanto — copy to .env and fill in.
# Only MOORCHEH_API_KEY is required; everything else has a working default.

# --- required -------------------------------------------------------------
# Memanto/Moorcheh API key. Get one at https://www.memanto.ai
MOORCHEH_API_KEY=

# Agent that receives the memories. Created automatically on first write.
# Can also be passed as attach(agent_id="...").
MEMANTO_LANGFUSE_AGENT_ID=my-agent

# --- your existing Langfuse setup ----------------------------------------
# Already set if your app uses Langfuse. LANGFUSE_PUBLIC_KEY also identifies
# which stored capture profile the handler uses, so keep it consistent with
# whatever `memanto migrate langfuse` runs against.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud is regional — use https://us.cloud.langfuse.com for US.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- optional tuning ------------------------------------------------------
# Which stored capture profile to use (defaults to the one keyed by your
# Langfuse public key, falling back to "default").
# MEMANTO_LANGFUSE_PROJECT=

# Seconds between background flushes.
# MEMANTO_LANGFUSE_FLUSH_INTERVAL=30

# Flush early once this many distinct spans are pending.
# MEMANTO_LANGFUSE_MAX_BUFFER=100

# Bound on in-process signature memory.
# MEMANTO_LANGFUSE_MAX_CACHE=2000

# Set false if agents are provisioned by your platform team and an app
# should fail rather than create one.
# MEMANTO_LANGFUSE_AUTO_CREATE_AGENT=true

# Lifetime of the agent session the handler opens.
# MEMANTO_LANGFUSE_SESSION_HOURS=24
