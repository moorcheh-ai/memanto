# OpenAI (required for most backends)
OPENAI_API_KEY=sk-...

# Anthropic (optional, for Claude-based backends)
ANTHROPIC_API_KEY=sk-ant-...

# Mem0 (optional, for Mem0 backend)
MEM0_API_KEY=m0-...
MEM0_ORG_ID=...
MEM0_PROJECT_ID=...

# Zep (optional, for Zep/Graphiti backend)
ZEP_API_KEY=...
ZEP_API_URL=https://api.getzep.com

# Letta (optional, for Letta backend)
LETTA_BASE_URL=http://localhost:8283
LETTA_AGENT_ID=...

# Benchmark configuration
BENCHMARK_OUTPUT_DIR=benchmark/results