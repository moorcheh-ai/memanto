# Required — get yours at https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# Optional overrides
# MEMANTO_AGENT_ID=team-shared        # fixed agent_id, overrides project-scoped default
# MEMANTO_AGENT_PATTERN=tool          # one of: support | project | tool (default: tool)
# MEMANTO_RECALL_LIMIT=5              # max memories injected per prompt (default: 5)
# MEMANTO_MIN_CONFIDENCE=0.6          # confidence threshold for inject (default: 0.6)
# MEMANTO_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR (default: INFO)
