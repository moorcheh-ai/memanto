# Required by Memanto/Moorcheh retrieval. Create a key at:
# https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your-moorcheh-api-key

# Optional. If omitted, the active Memanto agent is used.
MEMANTO_SKILL_AGENT_ID=claudecode-skills

# Keep transcript files and recalled context local to the project by default.
MEMANTO_SKILL_RUN_DIR=.memanto-skill-runs
MEMANTO_SKILL_CONTEXT_FILE=.memanto-skill-context.md
