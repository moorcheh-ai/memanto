{
  "$schema": "https://claude.ai/hooks-schema.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "\/(grill-with-docs|grill-me|review|challenge|decide|tdd|test|fix|handoff|freeze|architect|design|plan|capture|reflect|execute|board)",
        "hooks": [
          {
            "type": "command",
            "command": "python examples/claudecode-skills-memanto/bridge.py pre \"$CLAUDE_PROMPT\" \"$PWD\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "\/(grill-with-docs|grill-me|review|challenge|decide|tdd|test|fix|handoff|freeze|architect|design|plan|capture|reflect|execute|board)",
        "hooks": [
          {
            "type": "command",
            "command": "python examples/claudecode-skills-memanto/bridge.py post \"$CLAUDE_PROMPT\" \"$PWD\" \"$CLAUDE_RESPONSE\""
          }
        ]
      }
    ]
  }
}
