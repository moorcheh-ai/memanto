# Memanto Benchmark Showdown - 环境变量配置
# 复制此文件为 .env 并填写你的 API 密钥

# Memanto / Moorcheh API 密钥 (必须)
# 在 https://console.moorcheh.ai/api-keys 获取
MEMANTO_API_KEY=your_moorcheh_api_key_here

# Mem0 API 密钥 (必须)
# 在 https://app.mem0.ai 获取
MEM0_API_KEY=your_mem0_api_key_here

# 可选: 自定义 agent ID
MEMANTO_AGENT_ID=benchmark-agent

# 可选: 结果输出目录
BENCHMARK_OUTPUT=results/

# 可选: 每场景重复次数 (默认 3)
BENCHMARK_REPEAT=3
