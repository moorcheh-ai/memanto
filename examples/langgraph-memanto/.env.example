# Moorcheh API Key (required)
# Get yours at: https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# OpenAI API Key (required for LangGraph's LLM)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the LLM model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Use an OpenAI-compatible API (e.g., OpenRouter, local)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
