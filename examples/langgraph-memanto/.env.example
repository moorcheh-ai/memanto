# Moorcheh API Key (required)
# Get one free at https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# LLM API Key (any OpenAI-compatible provider)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Use other providers
# OPENAI_BASE_URL=https://api.tabcode.cc/v1
# OPENAI_API_KEY=sk-your-tabcode-key
