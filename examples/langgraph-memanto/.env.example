# Required for --backend memanto
# Get a key at https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# Optional: keep this fixed across separate seed/recall runs to prove recall
# comes from Memanto long-term memory rather than LangGraph thread state.
MEMANTO_LANGGRAPH_AGENT_ID=langgraph-support-agent
