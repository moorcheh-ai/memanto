# Moorcheh API key for Memanto (required)
# Get one at https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# OpenAI-compatible API key for LangChain (required for the LLM)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom user ID for demo cross-session recall
DEMO_USER_ID=demo-user-abc123
