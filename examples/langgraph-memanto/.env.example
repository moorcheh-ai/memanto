# Required: Moorcheh API Key (free tier: 100K ops/month)
# Get yours at https://console.moorcheh.ai/api-keys
MOORCHEH_API_KEY=moorcheh_your_key_here

# Required: OpenAI API Key (or use OpenRouter flag instead)
OPENAI_API_KEY=sk-your_key_here

# Optional: Use a different LLM model
LLM_MODEL=gpt-4o-mini
