# Memanto Configuration
# Get your API key at https://moorcheh.ai
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# Memanto server URL (default: http://localhost:8000)
MEMANTO_BASE_URL=http://localhost:8000

# OpenAI API key (for LangGraph agent)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API key (alternative to OpenAI)
# OPENROUTER_API_KEY=your_openrouter_key_here
