# Required for Moorcheh / Memanto
MOORCHEH_API_KEY=mk_your_moorcheh_key_here

# Required for Mem0 embeddings and LLM extraction
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Use Gemini as judge instead of OpenAI
# GEMINI_API_KEY=your-gemini-key-here

# Optional: Moorcheh custom base URL (for sovereign deployments)
# MOORCHEH_BASE_URL=https://api.moorcheh.ai/v1
