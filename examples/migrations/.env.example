# Memanto API key — get yours at https://console.moorcheh.ai
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# OpenRouter API key — required for validation/validate.py (LLM judge)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Zep Cloud API key — required for scripts/migrate_zep.py
# Get yours at https://app.getzep.com → Settings → API Keys
ZEP_API_KEY=your_zep_api_key_here

# Hindsight API key — required for scripts/migrate_hindsight.py
# Get yours at your Hindsight dashboard → Settings → API
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight base URL — optional, defaults to Hindsight cloud endpoint
# Set this only if you run a self-hosted Hindsight instance
HINDSIGHT_BASE_URL=

# Supermemory API key — required for scripts/migrate_supermemory.py
# Get yours at https://supermemory.ai → Settings → API
SUPERMEMORY_API_KEY=your_supermemory_api_key_here
