# Copy to .env and fill in your key. Never commit .env.
# Free Moorcheh API key: https://moorcheh.ai/
#
# Memanto CLI (get_client) reads MOORCHEH_API_KEY from the process
# environment, or from ~/.memanto/.env after you run `memanto` once.
# record_live_terminal.py also loads a local .env in this directory
# when present (without printing the value).

MOORCHEH_API_KEY=your_api_key_here
