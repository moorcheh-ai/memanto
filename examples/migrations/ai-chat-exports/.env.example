# Memanto migration showcase — environment configuration.
# Copy this file to `.env` and fill in YOUR values. Never commit `.env`.

# Moorcheh API key — powers Memanto's serverless retrieval engine.
# Get a free key at https://moorcheh.ai/
MOORCHEH_API_KEY=

# Memanto agent used for import / export / answer steps.
# Activate it first:  memanto agent activate <id>
MEMANTO_AGENT=claude-migration

# Default export path (relative to the bundle root, or absolute).
# Example: ./okf_output
OUTPUT_DIR=./okf_output
