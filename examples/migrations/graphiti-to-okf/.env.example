# Copy to .env and fill in. Never commit .env.

# --- Required for the Graphiti ingest (Phase 1) ---
# One of: openai | anthropic | gemini. Anthropic still needs OPENAI_API_KEY
# for embeddings (Anthropic has no embeddings API).
GRAPHITI_LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GRAPHITI_LLM_MODEL=gpt-4.1-mini

# --- Graphiti backend ---
# neo4j (preferred, via docker compose) | falkordb | kuzu (zero-Docker fallback)
GRAPHITI_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti-okf-demo
# KUZU_DB_PATH=./data/graphiti.kuzu
GRAPHITI_GROUP_ID=graphiti-okf-demo

# --- Required for Memanto migrate / answer / OKF export ---
MOORCHEH_API_KEY=
MEMANTO_AGENT_ID=graphiti-okf-demo

# --- Required for Phase 3 LLM-as-judge ---
ANTHROPIC_API_KEY=
# JUDGE_MODEL=claude-sonnet-4-5

# --- Required for Phase 4 Mem0 consolidation ---
MEM0_API_KEY=
