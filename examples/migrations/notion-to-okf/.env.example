# Required for live import into Memanto
MOORCHEH_API_KEY=your_moorcheh_api_key_here

# Agent ID to migrate memories into (default: notion-migration-demo)
MOORCHEH_AGENT_ID=notion-migration-demo

# Required only for --notion-live (fetch from real Notion API)
NOTION_API_KEY=secret_your_notion_integration_key_here

# Comma-separated Notion database IDs (for --notion-live)
# Find these in your database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx,yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
