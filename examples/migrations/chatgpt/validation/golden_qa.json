      "memory_ref": "chatgpt:conv-003:m-003b"
    },
    {
      "id": "qa-04",
      "question": "What's my dog called?",
      "expected_keywords": [["Biscuit"]],
      "memory_ref": "chatgpt:conv-003:m-003b"
    },
    {
      "id": "qa-05",
      "question": "What race am I training for?",
