# Moorcheh SDK Configuration
# Get your API key from https://app.moorcheh.ai
# Free tier: 500 monthly credits = ~100,000 operations
MOORCHEH_API_KEY=your_api_key_here

# AI / Answer Configuration (all optional — defaults shown)
# ANSWER_MODEL=anthropic.claude-sonnet-4-6
# ANSWER_TEMPERATURE=0.7
# ANSWER_LIMIT=5
# ANSWER_THRESHOLD=0.25
# RECALL_LIMIT=10

# Session Configuration (all optional — defaults shown)
# SESSION_DEFAULT_DURATION_HOURS=6
# SESSION_AUTO_RENEW_ENABLED=True
# SESSION_AUTO_RENEW_INTERVAL_HOURS=6
# SESSION_EXTEND_THRESHOLD_MINUTES=30
# Issue a fresh session on the first request after one has fully expired,
# instead of failing with 401. Still requires management access (a valid
# management credential or a loopback caller), and never revives a session
# that was explicitly ended.
# SESSION_AUTO_RECREATE_ENABLED=True

# Security Configuration (all optional — defaults shown)
# Interactive API docs (/docs, /redoc, /openapi.json) are disabled by default
# because the server binds 0.0.0.0. Enable only on a trusted network or behind
# an access-control layer - HTTPS protects transport, not access to the schema.
# MEMANTO_ENABLE_DOCS=False
# Refuse to start when MEMANTO would serve plain HTTP on a non-loopback
# interface (hard-fails even with DEBUG=true), and reject plain-HTTP requests
# on every entrypoint including direct `uvicorn memanto.app.main:app` runs.
# Loopback traffic is exempt from the request rejection so the local browser
# UI and in-container health checks (e.g. /ready) keep working.
# A non-empty MEMANTO_PROXY_ALLOWED_IPS is an exception: a trusted TLS-
# terminating proxy fronts the deployment, so startup is permitted. Direct
# Uvicorn launches must also use --no-proxy-headers (see below).
# MEMANTO_REQUIRE_SECURE=False
# Comma-separated IPs (or a JSON array) of trusted reverse proxies that
# terminate TLS. When set, X-Forwarded-Proto from those peers is honored so
# the session cookie is marked Secure for proxied (browser-facing HTTPS)
# sessions. The proxy must overwrite any client-supplied forwarding headers.
# Leave empty to never trust them (the default, safe posture).
# Uvicorn's built-in proxy-header handling is disabled on every launch path
# shipped with MEMANTO (memanto serve/ui, the __main__ entrypoint, and the
# Dockerfile's --no-proxy-headers). Direct `uvicorn memanto.app.main:app` runs
# must add --no-proxy-headers too, or an untrusted client can spoof the peer
# via X-Forwarded-For and defeat this allowlist. These peers are the only
# trusted source for the forwarded scheme.
# MEMANTO_PROXY_ALLOWED_IPS=