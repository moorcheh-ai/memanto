# Memanto Benchmark Suite — Environment Variables
# Copy this to .env and fill in your API keys

# Moorcheh API key (required for Memanto)
MOORCHEH_API_KEY=your_moorcheh_key_here

# Mem0 API key (required for Mem0 comparison)
MEM0_API_KEY=your_mem0_key_here

# OpenAI API key (required for LLM-as-a-Judge evaluation)
OPENAI_API_KEY=your_openai_key_here

# Judge model (default: gpt-4o)
JUDGE_MODEL=gpt-4o

# Number of benchmark runs for statistical aggregation
BENCHMARK_RUNS=3

# Random seed for reproducibility
RANDOM_SEED=42
